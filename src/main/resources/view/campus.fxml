<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.web.WebView?>

<ScrollPane
    xmlns="http://javafx.com/javafx/26"
    xmlns:fx="http://javafx.com/fxml/1"
    fx:controller="system.com.lostfound.CampusController"
    fitToWidth="true"
    fitToHeight="false"
    hbarPolicy="NEVER"
    vbarPolicy="AS_NEEDED"
    style="-fx-background-color: #F1F5F9;
           -fx-background: #F1F5F9;
           -fx-border-color: transparent;">

    <content>
        <GridPane
            hgap="18"
            vgap="18"
            maxWidth="Infinity"
            style="-fx-background-color: #F1F5F9;">

            <padding>
                <Insets top="18" right="18" bottom="25" left="18"/>
            </padding>

            <columnConstraints>
                <ColumnConstraints percentWidth="60" hgrow="ALWAYS" minWidth="0"/>
                <ColumnConstraints percentWidth="40" hgrow="ALWAYS" minWidth="0"/>
            </columnConstraints>

            <!-- LEFT: INTERACTIVE MAP -->
            <VBox
                spacing="11"
                minWidth="0"
                maxWidth="Infinity"
                GridPane.columnIndex="0"
                GridPane.rowIndex="0"
                style="-fx-background-color: white;
                       -fx-background-radius: 14;
                       -fx-border-color: #E2E8F0;
                       -fx-border-radius: 14;">

                <padding>
                    <Insets top="18" right="18" bottom="18" left="18"/>
                </padding>

                <Label
                    text="LSPU Campus Network"
                    wrapText="true"
                    maxWidth="Infinity"
                    style="-fx-font-size: 21px;
                           -fx-font-weight: bold;
                           -fx-text-fill: #174D48;"/>

                <Label
                    text="Select a campus marker on the map to explore its location and information."
                    wrapText="true"
                    maxWidth="Infinity"
                    style="-fx-font-size: 13px;
                           -fx-text-fill: #64748B;"/>

                <!-- INTERACTIVE MAP -->
                <StackPane
                    prefHeight="360"
                    minHeight="280"
                    maxWidth="Infinity"
                    VBox.vgrow="ALWAYS"
                    style="-fx-background-color: #E2E8F0;
                           -fx-background-radius: 10;">

                    <WebView
                        fx:id="mapView"
                        minWidth="0"
                        minHeight="280"
                        prefHeight="360"
                        maxWidth="Infinity"
                        maxHeight="Infinity"/>
                </StackPane>

                <Label
                    fx:id="mapStatusLabel"
                    text="Loading interactive campus map..."
                    wrapText="true"
                    maxWidth="Infinity"
                    style="-fx-font-size: 11px;
                           -fx-text-fill: #64748B;"/>

                <Label
                    text="QUICK CAMPUS SELECTION"
                    wrapText="true"
                    style="-fx-font-size: 13px;
                           -fx-font-weight: bold;
                           -fx-text-fill: #0F766E;"/>

                <!-- CAMPUS BUTTONS -->
                <GridPane hgap="10" vgap="10">

                    <columnConstraints>
                        <ColumnConstraints percentWidth="50" hgrow="ALWAYS"/>
                        <ColumnConstraints percentWidth="50" hgrow="ALWAYS"/>
                    </columnConstraints>

                    <Button
                        text="SINILOAN"
                        onAction="#selectSiniloan"
                        maxWidth="Infinity"
                        prefHeight="38"
                        GridPane.columnIndex="0"
                        GridPane.rowIndex="0"
                        style="-fx-background-color: #01796F;
                               -fx-text-fill: white;
                               -fx-font-weight: bold;
                               -fx-background-radius: 7;"/>

                    <Button
                        text="SANTA CRUZ"
                        onAction="#selectSantaCruz"
                        maxWidth="Infinity"
                        prefHeight="38"
                        GridPane.columnIndex="1"
                        GridPane.rowIndex="0"
                        style="-fx-background-color: #0F766E;
                               -fx-text-fill: white;
                               -fx-font-weight: bold;
                               -fx-background-radius: 7;"/>

                    <Button
                        text="LOS BAÑOS"
                        onAction="#selectLosBanos"
                        maxWidth="Infinity"
                        prefHeight="38"
                        GridPane.columnIndex="0"
                        GridPane.rowIndex="1"
                        style="-fx-background-color: #0F766E;
                               -fx-text-fill: white;
                               -fx-font-weight: bold;
                               -fx-background-radius: 7;"/>

                    <Button
                        text="SAN PABLO"
                        onAction="#selectSanPablo"
                        maxWidth="Infinity"
                        prefHeight="38"
                        GridPane.columnIndex="1"
                        GridPane.rowIndex="1"
                        style="-fx-background-color: #0F766E;
                               -fx-text-fill: white;
                               -fx-font-weight: bold;
                               -fx-background-radius: 7;"/>

                </GridPane>
            </VBox>

            <!-- RIGHT: CAMPUS DETAILS -->
            <VBox
                spacing="14"
                minWidth="0"
                maxWidth="Infinity"
                GridPane.columnIndex="1"
                GridPane.rowIndex="0"
                style="-fx-background-color: white;
                       -fx-background-radius: 14;
                       -fx-border-color: #E2E8F0;
                       -fx-border-radius: 14;">

                <padding>
                    <Insets top="20" right="18" bottom="20" left="18"/>
                </padding>

                <Label
                    text="CAMPUS DETAILS"
                    wrapText="true"
                    style="-fx-font-size: 19px;
                           -fx-font-weight: bold;
                           -fx-text-fill: #01796F;"/>

                <!-- CAMPUS PHOTO -->
                <StackPane
                    fx:id="campusImageContainer"
                    prefHeight="220"
                    minHeight="180"
                    maxHeight="220"
                    maxWidth="Infinity"
                    style="-fx-background-color: #F1F5F9;
                           -fx-background-radius: 10;">

                    <ImageView
                        fx:id="campusImage"
                        fitWidth="300"
                        fitHeight="210"
                        preserveRatio="true"
                        smooth="true"/>
                </StackPane>

                <!-- CAMPUS NAME -->
                <VBox spacing="5">
                    <Label
                        text="CAMPUS NAME"
                        style="-fx-text-fill: #64748B;
                               -fx-font-size: 12px;"/>

                    <Label
                        fx:id="campusNameLabel"
                        text="Select a campus"
                        wrapText="true"
                        maxWidth="Infinity"
                        style="-fx-font-size: 21px;
                               -fx-font-weight: bold;
                               -fx-text-fill: #174D48;"/>
                </VBox>

                <!-- LOCATION -->
                <VBox spacing="5">
                    <Label
                        text="LOCATION"
                        style="-fx-text-fill: #01796F;
                               -fx-font-size: 13px;
                               -fx-font-weight: bold;"/>

                    <Label
                        fx:id="locationLabel"
                        text="Campus location"
                        wrapText="true"
                        maxWidth="Infinity"
                        style="-fx-font-size: 13px;
                               -fx-text-fill: #334155;"/>
                </VBox>

                <!-- INFORMATION -->
                <VBox spacing="6">
                    <Label
                        text="CAMPUS INFORMATION"
                        wrapText="true"
                        style="-fx-text-fill: #01796F;
                               -fx-font-size: 14px;
                               -fx-font-weight: bold;"/>

                    <Label
                        fx:id="informationLabel"
                        text="Choose a campus marker to see its information."
                        wrapText="true"
                        maxWidth="Infinity"
                        style="-fx-font-size: 12px;
                               -fx-text-fill: #334155;
                               -fx-line-spacing: 3;"/>
                </VBox>

                <!-- PROGRAMS -->
                <VBox spacing="6">
                    <Label
                        text="PROGRAMS OFFERED"
                        wrapText="true"
                        style="-fx-text-fill: #01796F;
                               -fx-font-size: 14px;
                               -fx-font-weight: bold;"/>

                    <Label
                        fx:id="programsLabel"
                        text="Select a campus"
                        wrapText="true"
                        maxWidth="Infinity"
                        style="-fx-font-size: 12px;
                               -fx-text-fill: #334155;"/>
                </VBox>

                <Label
                    text="LSPU Heritage and Campus Network Navigator"
                    wrapText="true"
                    maxWidth="Infinity"
                    style="-fx-font-size: 11px;
                           -fx-text-fill: #94A3B8;"/>

            </VBox>

        </GridPane>
    </content>
</ScrollPane>
