<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefWidth="1200.0"
            prefHeight="750.0"
            xmlns="http://javafx.com/javafx/26"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="system.com.lostfound.LoginController">

    <children>

        <!-- BACKGROUND IMAGE -->
        <ImageView fitWidth="1200.0"
                   fitHeight="750.0"
                   preserveRatio="false"
                   mouseTransparent="true"
                   AnchorPane.topAnchor="0.0"
                   AnchorPane.bottomAnchor="0.0"
                   AnchorPane.leftAnchor="0.0"
                   AnchorPane.rightAnchor="0.0">

            <image>
                <Image url="@image/LSPU_thumbnail.jpg"/>
            </image>

        </ImageView>

        <!-- CENTER THE LOGIN BOX -->
        <StackPane alignment="CENTER"
                   AnchorPane.topAnchor="0.0"
                   AnchorPane.bottomAnchor="0.0"
                   AnchorPane.leftAnchor="0.0"
                   AnchorPane.rightAnchor="0.0">

            <!-- LOGIN RECTANGULAR BOX -->
            <VBox alignment="CENTER"
                  spacing="18.0"
                  prefWidth="500.0"
                  prefHeight="600.0"
                  minWidth="500.0"
                  minHeight="600.0"
                  maxWidth="500.0"
                  maxHeight="600.0"
                  style="-fx-background-color: rgba(0,0,0,0.60);
                         -fx-border-color: #5db582;
                         -fx-border-width: 2;
                         -fx-background-radius: 5;
                         -fx-border-radius: 5;">

                <padding>
                    <Insets top="25.0"
                            bottom="25.0"
                            left="45.0"
                            right="45.0"/>
                </padding>

                <!-- LSPU LOGO -->
                <ImageView fitWidth="110.0"
                           fitHeight="100.0"
                           preserveRatio="true">

                    <image>
                        <Image url="@image/LSPU-Logo.png"/>
                    </image>

                </ImageView>

                <!-- SYSTEM NAME -->
                <Label text="LSPU-HNN"
                       alignment="CENTER"
                       textFill="#5db582"
                       style="-fx-font-size: 48px;
                              -fx-font-weight: bold;
                              -fx-border-color: transparent transparent transparent #45805e;
                              -fx-border-width: 0 0 0 6;
                              -fx-padding: 0 0 0 8;">

                    <font>
                        <Font name="PT Sans Caption Bold" size="48.0"/>
                    </font>

                </Label>

                <!-- WELCOME MESSAGE -->
                <Label text="Welcome Back!"
                       alignment="CENTER"
                       textFill="WHITE"
                       style="-fx-font-size: 18px;
                              -fx-font-weight: bold;"/>

                <!-- ACCOUNT TYPE LABEL -->
                <Label text="ACCOUNT TYPE"
                       alignment="CENTER"
                       textFill="WHITE"
                       style="-fx-font-weight: bold;"/>

                <!-- ACCOUNT TYPE SELECTION -->
                <ComboBox fx:id="accountTypeComboBox"
                          onAction="#handleAccountTypeChange"
                          prefWidth="380.0"
                          prefHeight="42.0"
                          maxWidth="380.0"
                          promptText="Select Account Type"/>

                <!-- SCHOOL ID -->
                <TextField fx:id="nameField"
                           prefWidth="380.0"
                           prefHeight="42.0"
                           maxWidth="380.0"
                           promptText="Enter your School ID"/>

                <!-- ADMIN PASSWORD -->
                <PasswordField fx:id="passwordField"
                               managed="false"
                               visible="false"
                               prefWidth="380.0"
                               prefHeight="42.0"
                               maxWidth="380.0"
                               promptText="Enter Admin Password"/>

                <!-- LOGIN BUTTON -->
                <Button text="LOGIN"
                        onAction="#handleLogin"
                        prefWidth="380.0"
                        prefHeight="48.0"
                        maxWidth="380.0"
                        style="-fx-background-color: #5db582;
                               -fx-text-fill: white;
                               -fx-font-weight: bold;
                               -fx-font-size: 15px;"/>

            </VBox>

        </StackPane>

    </children>
</AnchorPane>
