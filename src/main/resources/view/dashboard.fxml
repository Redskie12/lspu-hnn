<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.chart.BarChart?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.chart.PieChart?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.Slider?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.media.MediaView?>

<BorderPane minHeight="650.0"
            minWidth="1000.0"
            prefHeight="800.0"
            prefWidth="1500.0"
            style="-fx-background-color: #F1F7F5;"
            stylesheets="@../style.css"
            xmlns="http://javafx.com/javafx/26"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="system.com.lostfound.DashboardController">

    <!-- HEADER -->
    <top>
        <HBox alignment="CENTER_LEFT"
              prefHeight="75.0"
              spacing="12.0"
              style="-fx-background-color: linear-gradient(to right, #00695C, #008577, #009688);
                     -fx-padding: 0 22;">

            <ImageView fitHeight="48"
                       fitWidth="48"
                       preserveRatio="true"
                       smooth="true">
                <image>
                    <Image url="@image/lspu-logo.png" />
                </image>
            </ImageView>

            <Label style="-fx-font-size: 27px;
                          -fx-font-weight: bold;
                          -fx-text-fill: white;"
                   text="LSPU-HNN" />

            <Label style="-fx-font-size: 14px;
                          -fx-text-fill: #E0F2F1;"
                   text="Heritage &amp; Campus Network Navigator" />

            <Region HBox.hgrow="ALWAYS" />

            <Button fx:id="profileButton"
                    maxHeight="46"
                    maxWidth="46"
                    minHeight="46"
                    minWidth="46"
                    onAction="#handleProfileMenu"
                    prefHeight="46"
                    prefWidth="46"
                    style="-fx-background-color: #DCEBDD;
                           -fx-text-fill: #285C35;
                           -fx-font-size: 22px;
                           -fx-background-radius: 50em;
                           -fx-border-color: white;
                           -fx-border-width: 2;
                           -fx-border-radius: 50em;
                           -fx-padding: 0;
                           -fx-cursor: hand;"
                    text="👤" />
        </HBox>
    </top>

    <!-- SIDEBAR -->
    <left>
        <VBox fx:id="sidebar"
              minWidth="230"
              prefWidth="255"
              spacing="12"
              style="-fx-background-color: #D0DEDA;
                     -fx-padding: 25 15;">

            <Label style="-fx-font-size: 12px;
                          -fx-font-weight: bold;
                          -fx-text-fill: #526B68;
                          -fx-padding: 0 10 12 10;"
                   text="MAIN MENU" />

            <VBox fx:id="navigationButtons" spacing="8">

                <Button fx:id="dashboardNavButton"
                        alignment="CENTER_LEFT"
                        maxWidth="Infinity"
                        onAction="#handleDashboard"
                        styleClass="sidebar-button-active"
                        text="Dashboard" />

                <Button fx:id="historyNavButton"
                        alignment="CENTER_LEFT"
                        maxWidth="Infinity"
                        onAction="#handleHistory"
                        styleClass="sidebar-button"
                        text="History Explorer &amp; BST" />

                <Button fx:id="campusNavButton"
                        alignment="CENTER_LEFT"
                        maxWidth="Infinity"
                        onAction="#handleCampus"
                        styleClass="sidebar-button"
                        text="Campus Network" />

                <Button fx:id="traversalNavButton"
                        alignment="CENTER_LEFT"
                        maxWidth="Infinity"
                        onAction="#handleTraversal"
                        styleClass="sidebar-button"
                        text="BFS &amp; DFS" />

                <Button fx:id="timelineNavButton"
                        alignment="CENTER_LEFT"
                        maxWidth="Infinity"
                        onAction="#handleTimeline"
                        styleClass="sidebar-button"
                        text="Historical Timeline" />

                <Button fx:id="lostFoundNavButton"
                        alignment="CENTER_LEFT"
                        maxWidth="Infinity"
                        onAction="#handleLostFound"
                        styleClass="sidebar-button"
                        text="Lost and Found" />

            </VBox>

            <Region VBox.vgrow="ALWAYS" />

            <Separator />

            <Label style="-fx-font-size: 15px;
                          -fx-font-weight: bold;
                          -fx-text-fill: #294B47;"
                   text="LSPU-HNN" />

            <Label style="-fx-font-size: 11px;
                          -fx-text-fill: #526B68;"
                   text="Heritage &amp; Campus Network Navigator"
                   wrapText="true" />

        </VBox>
    </left>

    <!-- MAIN DASHBOARD -->
    <center>
        <StackPane fx:id="contentArea"
                   minWidth="0"
                   style="-fx-background-color: #F1F7F5;">

            <ScrollPane fx:id="dashboardScrollPane"
                        fitToHeight="false"
                        fitToWidth="true"
                        hbarPolicy="NEVER"
                        maxWidth="Infinity"
                        pannable="false"
                        style="-fx-background-color: transparent;
                               -fx-background: transparent;
                               -fx-border-color: transparent;"
                        vbarPolicy="AS_NEEDED">

                <VBox fx:id="dashboardContent"
                      fillWidth="true"
                      maxWidth="Infinity"
                      minWidth="0"
                      spacing="24"
                      style="-fx-padding: 25;">

                    <!-- WELCOME BANNER -->
                    <StackPane fx:id="welcomeBanner"
                               maxHeight="250"
                               maxWidth="Infinity"
                               minHeight="250"
                               prefHeight="250"
                               style="-fx-background-color: linear-gradient(to right, #004D40, #00796F, #00A58A);
                                      -fx-background-radius: 18;">

                        <ImageView fx:id="campusImageView"
                                   fitHeight="250"
                                   fitWidth="1000"
                                   preserveRatio="false"
                                   smooth="true">
                            <image>
                                <Image url="@image/greenlspu.jpeg" />
                            </image>
                        </ImageView>

                        <Region maxHeight="Infinity"
                                maxWidth="Infinity"
                                mouseTransparent="true"
                                style="-fx-background-color: linear-gradient(to right, rgba(0,48,40,0.96), rgba(0,85,65,0.86), rgba(0,121,111,0.68));
                                       -fx-background-radius: 18;" />

                        <VBox alignment="CENTER_LEFT"
                              maxWidth="Infinity"
                              prefHeight="243.0"
                              prefWidth="1165.0"
                              spacing="12"
                              style="-fx-padding: 30 35;
                                     -fx-border-radius: 18;">

                            <Label style="-fx-font-size: 32px;
                                          -fx-font-weight: bold;
                                          -fx-text-fill: white;"
                                   text="WELCOME TO LSPU-HNN"
                                   wrapText="true" />

                            <Label style="-fx-font-size: 17px;
                                          -fx-font-weight: bold;
                                          -fx-text-fill: #DDF5E9;"
                                   text="Heritage &amp; Campus Network Navigator"
                                   wrapText="true" />

                            <Label maxWidth="700"
                                   style="-fx-font-size: 14px;
                                          -fx-text-fill: white;"
                                   text="Discover the history, campuses, and heritage of Laguna State Polytechnic University."
                                   wrapText="true" />
                        </VBox>
                    </StackPane>

                    <!-- OVERVIEW -->
                    <VBox spacing="6">

                        <Label style="-fx-font-size: 22px;
                                      -fx-font-weight: bold;
                                      -fx-text-fill: #244B45;"
                               text="Dashboard Overview" />

                        <Label style="-fx-font-size: 13px;
                                      -fx-text-fill: #71817E;"
                               text="Quick overview of the system" />

                    </VBox>

                    <!-- STATISTICS -->
                    <HBox alignment="CENTER"
                          fillHeight="true"
                          spacing="15">

                        <VBox minWidth="0"
                              spacing="10"
                              style="-fx-background-color: white;
                                     -fx-background-radius: 12;
                                     -fx-padding: 20;"
                              styleClass="dashboard-card"
                              HBox.hgrow="ALWAYS">

                            <Label style="-fx-font-size: 12px;
                                          -fx-text-fill: #71817E;
                                          -fx-font-weight: bold;"
                                   text="CAMPUSES" />

                            <Label style="-fx-font-size: 30px;
                                          -fx-font-weight: bold;
                                          -fx-text-fill: #008577;"
                                   text="4" />

                            <Label style="-fx-font-size: 12px;
                                          -fx-text-fill: #71817E;"
                                   text="University Campuses"
                                   wrapText="true" />
                        </VBox>

                        <VBox minWidth="0"
                              spacing="10"
                              style="-fx-background-color: white;
                                     -fx-background-radius: 12;
                                     -fx-padding: 20;"
                              styleClass="dashboard-card"
                              HBox.hgrow="ALWAYS">

                            <Label style="-fx-font-size: 12px;
                                          -fx-text-fill: #71817E;
                                          -fx-font-weight: bold;"
                                   text="HISTORICAL RECORDS"
                                   wrapText="true" />

                            <Label style="-fx-font-size: 30px;
                                          -fx-font-weight: bold;
                                          -fx-text-fill: #008577;"
                                   text="8" />

                            <Label style="-fx-font-size: 12px;
                                          -fx-text-fill: #71817E;"
                                   text="Available Records"
                                   wrapText="true" />
                        </VBox>

                        <VBox minWidth="0"
                              spacing="10"
                              style="-fx-background-color: white;
                                     -fx-background-radius: 12;
                                     -fx-padding: 20;"
                              styleClass="dashboard-card"
                              HBox.hgrow="ALWAYS">

                            <Label style="-fx-font-size: 12px;
                                          -fx-text-fill: #71817E;
                                          -fx-font-weight: bold;"
                                   text="LOST ITEMS" />

                            <Label fx:id="lostCountLabel"
                                   style="-fx-font-size: 30px;
                                          -fx-font-weight: bold;
                                          -fx-text-fill: #D97757;"
                                   text="0" />

                            <Label style="-fx-font-size: 12px;
                                          -fx-text-fill: #71817E;"
                                   text="Reported Lost Items"
                                   wrapText="true" />
                        </VBox>

                        <VBox minWidth="0"
                              spacing="10"
                              style="-fx-background-color: white;
                                     -fx-background-radius: 12;
                                     -fx-padding: 20;"
                              styleClass="dashboard-card"
                              HBox.hgrow="ALWAYS">

                            <Label style="-fx-font-size: 12px;
                                          -fx-text-fill: #71817E;
                                          -fx-font-weight: bold;"
                                   text="FOUND ITEMS" />

                            <Label fx:id="foundCountLabel"
                                   style="-fx-font-size: 30px;
                                          -fx-font-weight: bold;
                                          -fx-text-fill: #008577;"
                                   text="0" />

                            <Label style="-fx-font-size: 12px;
                                          -fx-text-fill: #71817E;"
                                   text="Reported Found Items"
                                   wrapText="true" />
                        </VBox>

                    </HBox>

                    <!-- SYSTEM ANALYTICS -->
                    <VBox spacing="15">

                        <Label style="-fx-font-size: 22px;
                                      -fx-font-weight: bold;
                                      -fx-text-fill: #244B45;"
                               text="System Analytics" />

                        <HBox alignment="TOP_CENTER" spacing="18">

                            <VBox minWidth="0"
                                  spacing="10"
                                  style="-fx-background-color: white;
                                         -fx-background-radius: 12;
                                         -fx-padding: 18;"
                                  styleClass="dashboard-card"
                                  HBox.hgrow="ALWAYS">

                                <Label style="-fx-font-size: 15px;
                                              -fx-font-weight: bold;
                                              -fx-text-fill: #294B47;"
                                       text="Historical Records Overview"
                                       wrapText="true" />

                                <BarChart fx:id="historicalChart"
                                          animated="true"
                                          categoryGap="25"
                                          legendVisible="false"
                                          minHeight="250"
                                          minWidth="0"
                                          prefHeight="300">

                                    <xAxis>
                                        <CategoryAxis label="Category"
                                                      tickLabelFill="#526B68" />
                                    </xAxis>

                                    <yAxis>
                                        <NumberAxis forceZeroInRange="true"
                                                     label="Number of Records"
                                                     tickLabelFill="#526B68" />
                                    </yAxis>

                                </BarChart>
                            </VBox>

                            <VBox minWidth="0"
                                  spacing="10"
                                  style="-fx-background-color: white;
                                         -fx-background-radius: 12;
                                         -fx-padding: 18;"
                                  styleClass="dashboard-card"
                                  HBox.hgrow="ALWAYS">

                                <Label style="-fx-font-size: 15px;
                                              -fx-font-weight: bold;
                                              -fx-text-fill: #294B47;"
                                       text="Lost and Found Status"
                                       wrapText="true" />

                                <PieChart fx:id="statusChart"
                                          animated="true"
                                          minHeight="250"
                                          prefHeight="300" />
                            </VBox>

                        </HBox>
                    </VBox>

                    <!-- VIDEO -->
                    <VBox spacing="15"
                          style="-fx-background-color: white;
                                 -fx-background-radius: 12;
                                 -fx-padding: 20;"
                          styleClass="dashboard-card">

                        <Label style="-fx-font-size: 22px;
                                      -fx-font-weight: bold;
                                      -fx-text-fill: #244B45;"
                               text="Discover LSPU" />

                        <Label style="-fx-font-size: 13px;
                                      -fx-text-fill: #71817E;"
                               text="Watch and explore more about Laguna State Polytechnic University."
                               wrapText="true" />

                        <StackPane maxWidth="Infinity"
                                   minHeight="280"
                                   prefHeight="320"
                                   style="-fx-background-color: #172B28;
                                          -fx-background-radius: 10;">

                            <MediaView fx:id="videoView"
                                       fitHeight="300"
                                       fitWidth="900"
                                       preserveRatio="true" />
                        </StackPane>

                        <!-- VIDEO TIME AND PROGRESS -->
                        <VBox spacing="6">

                            <Slider fx:id="videoProgressSlider"
                                    min="0"
                                    max="1"
                                    value="0"
                                    disable="true"
                                    maxWidth="Infinity"
                                    style="-fx-control-inner-background: #DCEBDD;
                                           -fx-accent: #008577;" />

                            <HBox alignment="CENTER_LEFT">

                                <Label fx:id="videoCurrentTimeLabel"
                                       text="00:00"
                                       style="-fx-font-size: 12px;
                                              -fx-font-weight: bold;
                                              -fx-text-fill: #526B68;" />

                                <Region HBox.hgrow="ALWAYS" />

                                <Label fx:id="videoDurationLabel"
                                       text="00:00"
                                       style="-fx-font-size: 12px;
                                              -fx-font-weight: bold;
                                              -fx-text-fill: #526B68;" />

                            </HBox>
                        </VBox>

                        <!-- VIDEO CONTROLS -->
                        <HBox alignment="CENTER"
                              spacing="10">

                            <Button fx:id="rewindButton"
                                    onAction="#handleRewindVideo"
                                    style="-fx-background-color: #DCEBDD;
                                           -fx-text-fill: #285C35;
                                           -fx-font-weight: bold;
                                           -fx-background-radius: 7;
                                           -fx-padding: 10 15;"
                                    text="↶ 10s" />

                            <Button fx:id="playButton"
                                    onAction="#handlePlayPause"
                                    style="-fx-background-color: linear-gradient(to right, #00695C, #009688);
                                           -fx-text-fill: white;
                                           -fx-font-weight: bold;
                                           -fx-background-radius: 7;
                                           -fx-padding: 10 20;"
                                    styleClass="video-control-button"
                                    text="▶ Play" />

                            <Button fx:id="fastForwardButton"
                                    onAction="#handleFastForwardVideo"
                                    style="-fx-background-color: #DCEBDD;
                                           -fx-text-fill: #285C35;
                                           -fx-font-weight: bold;
                                           -fx-background-radius: 7;
                                           -fx-padding: 10 15;"
                                    text="10s ↷" />

                            <Button onAction="#handleStopVideo"
                                    style="-fx-background-color: #D97757;
                                           -fx-text-fill: white;
                                           -fx-font-weight: bold;
                                           -fx-background-radius: 7;
                                           -fx-padding: 10 20;"
                                    styleClass="video-control-button"
                                    text="■ Stop" />

                            <Button onAction="#handleReplayVideo"
                                    style="-fx-background-color: #DCEBDD;
                                           -fx-text-fill: #285C35;
                                           -fx-font-weight: bold;
                                           -fx-background-radius: 7;
                                           -fx-padding: 10 20;"
                                    styleClass="video-control-button"
                                    text="↻ Replay" />

                        </HBox>

                        <Label fx:id="videoStatusLabel"
                               style="-fx-font-size: 12px;
                                      -fx-text-fill: #71817E;"
                               text="Ready to play" />
                    </VBox>

                    <!-- RECENT ACTIVITIES -->
                    <VBox spacing="15"
                          style="-fx-background-color: white;
                                 -fx-background-radius: 12;
                                 -fx-padding: 20;"
                          styleClass="dashboard-card">

                        <Label style="-fx-font-size: 22px;
                                      -fx-font-weight: bold;
                                      -fx-text-fill: #244B45;"
                               text="Recent Activities" />

                        <VBox fx:id="recentActivityBox" spacing="10">
                            <Label style="-fx-font-size: 13px;
                                          -fx-text-fill: #71817E;"
                                   text="No recent activities available." />
                        </VBox>
                    </VBox>

                    <!-- ADMIN LOGIN HISTORY -->
                    <VBox fx:id="loginHistorySection"
                          spacing="15"
                          visible="false"
                          managed="false"
                          style="-fx-background-color: white;
                                 -fx-background-radius: 12;
                                 -fx-padding: 20;"
                          styleClass="dashboard-card">

                        <VBox spacing="5">

                            <Label style="-fx-font-size: 22px;
                                          -fx-font-weight: bold;
                                          -fx-text-fill: #244B45;"
                                   text="Recent Login Accounts" />

                        </VBox>

                        <VBox fx:id="loginHistoryBox"
                              spacing="10">

                            <Label style="-fx-font-size: 13px;
                                          -fx-text-fill: #71817E;"
                                   text="Loading login history..." />

                        </VBox>
                    </VBox>

                    <!-- LEARNING MODULES -->
                    <VBox spacing="15"
                          style="-fx-background-color: white;
                                 -fx-background-radius: 12;
                                 -fx-padding: 22;"
                          styleClass="dashboard-card">

                        <VBox spacing="5">

                            <Label style="-fx-font-size: 22px;
                                          -fx-font-weight: bold;
                                          -fx-text-fill: #244B45;"
                                   text="Learning Modules" />

                            <Label style="-fx-font-size: 13px;
                                          -fx-text-fill: #71817E;"
                                   text="Explore the features and learn how the LSPU-HNN system works."
                                   wrapText="true" />
                        </VBox>

                        <HBox alignment="TOP_CENTER" spacing="15">

                            <VBox minWidth="0"
                                  spacing="10"
                                  style="-fx-background-color: #F1F7F5;
                                         -fx-background-radius: 10;
                                         -fx-padding: 18;"
                                  styleClass="module-card"
                                  HBox.hgrow="ALWAYS">

                                <Label style="-fx-font-size: 13px;
                                              -fx-font-weight: bold;
                                              -fx-text-fill: #D97757;"
                                       text="01" />

                                <Label style="-fx-font-size: 17px;
                                              -fx-font-weight: bold;
                                              -fx-text-fill: #244B45;"
                                       text="University History"
                                       wrapText="true" />

                                <Label style="-fx-font-size: 12px;
                                              -fx-text-fill: #71817E;"
                                       text="Explore important historical records and learn about the development of LSPU."
                                       wrapText="true" />

                                <Button maxWidth="Infinity"
                                        onAction="#handleHistory"
                                        style="-fx-background-color: #00796F;
                                               -fx-text-fill: white;
                                               -fx-font-weight: bold;
                                               -fx-background-radius: 7;
                                               -fx-padding: 9;"
                                        text="Open Module" />
                            </VBox>

                            <VBox minWidth="0"
                                  spacing="10"
                                  style="-fx-background-color: #F1F7F5;
                                         -fx-background-radius: 10;
                                         -fx-padding: 18;"
                                  styleClass="module-card"
                                  HBox.hgrow="ALWAYS">

                                <Label style="-fx-font-size: 13px;
                                              -fx-font-weight: bold;
                                              -fx-text-fill: #D97757;"
                                       text="02" />

                                <Label style="-fx-font-size: 17px;
                                              -fx-font-weight: bold;
                                              -fx-text-fill: #244B45;"
                                       text="Campus Network"
                                       wrapText="true" />

                                <Label style="-fx-font-size: 12px;
                                              -fx-text-fill: #71817E;"
                                       text="Discover the university campuses and explore their connections."
                                       wrapText="true" />

                                <Button maxWidth="Infinity"
                                        onAction="#handleCampus"
                                        style="-fx-background-color: #00796F;
                                               -fx-text-fill: white;
                                               -fx-font-weight: bold;
                                               -fx-background-radius: 7;
                                               -fx-padding: 9;"
                                        text="Open Module" />
                            </VBox>

                        </HBox>

                        <HBox alignment="TOP_CENTER" spacing="15">

                            <VBox minWidth="0"
                                  spacing="10"
                                  style="-fx-background-color: #F1F7F5;
                                         -fx-background-radius: 10;
                                         -fx-padding: 18;"
                                  styleClass="module-card"
                                  HBox.hgrow="ALWAYS">

                                <Label style="-fx-font-size: 13px;
                                              -fx-font-weight: bold;
                                              -fx-text-fill: #D97757;"
                                       text="03" />

                                <Label style="-fx-font-size: 17px;
                                              -fx-font-weight: bold;
                                              -fx-text-fill: #244B45;"
                                       text="Graph Traversal: BFS &amp; DFS"
                                       wrapText="true" />

                                <Label style="-fx-font-size: 12px;
                                              -fx-text-fill: #71817E;"
                                       text="Understand how Breadth-First Search and Depth-First Search explore a network."
                                       wrapText="true" />

                                <Button maxWidth="Infinity"
                                        onAction="#handleTraversal"
                                        style="-fx-background-color: #00796F;
                                               -fx-text-fill: white;
                                               -fx-font-weight: bold;
                                               -fx-background-radius: 7;
                                               -fx-padding: 9;"
                                        text="Open Module" />
                            </VBox>

                            <VBox minWidth="0"
                                  spacing="10"
                                  style="-fx-background-color: #F1F7F5;
                                         -fx-background-radius: 10;
                                         -fx-padding: 18;"
                                  styleClass="module-card"
                                  HBox.hgrow="ALWAYS">

                                <Label style="-fx-font-size: 13px;
                                              -fx-font-weight: bold;
                                              -fx-text-fill: #D97757;"
                                       text="04" />

                                <Label style="-fx-font-size: 17px;
                                              -fx-font-weight: bold;
                                              -fx-text-fill: #244B45;"
                                       text="Lost and Found"
                                       wrapText="true" />

                                <Label style="-fx-font-size: 12px;
                                              -fx-text-fill: #71817E;"
                                       text="Learn how to report, view, and track lost and found items in the university."
                                       wrapText="true" />

                                <Button maxWidth="Infinity"
                                        onAction="#handleLostFound"
                                        style="-fx-background-color: #00796F;
                                               -fx-text-fill: white;
                                               -fx-font-weight: bold;
                                               -fx-background-radius: 7;
                                               -fx-padding: 9;"
                                        text="Open Module" />
                            </VBox>

                        </HBox>
                    </VBox>

                    <!-- FOOTER -->
                    <VBox alignment="CENTER"
                          spacing="7"
                          style="-fx-padding: 20 0 10 0;">

                        <Separator />

                        <Label style="-fx-font-size: 12px;
                                      -fx-font-weight: bold;
                                      -fx-text-fill: #526B68;"
                               text="LSPU-HNN | Heritage &amp; Campus Network Navigator" />

                        <Label style="-fx-font-size: 11px;
                                      -fx-text-fill: #879692;"
                               text="Laguna State Polytechnic University" />

                    </VBox>

                </VBox>
            </ScrollPane>
        </StackPane>
    </center>

</BorderPane>
