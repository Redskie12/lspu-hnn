<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>

<BorderPane style="-fx-background-color: #f4f7f5;"
            xmlns="http://javafx.com/javafx/26"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="system.com.lostfound.LostFoundController">

    <center>
        <ScrollPane fitToWidth="true"
                    hbarPolicy="NEVER"
                    style="-fx-background-color: transparent; -fx-background: transparent;">
            <content>
                <VBox spacing="18" style="-fx-padding: 24;">

                    <!-- PAGE TITLE -->
                    <VBox spacing="5">
                        <Label style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: #174d35;"
                               text="Lost &amp; Found Management"/>
                        <Label style="-fx-font-size: 13px; -fx-text-fill: #66756c;"
                               text="Report, manage, and view lost and found items across LSPU campuses."/>
                    </VBox>

                    <!-- SUMMARY CARDS -->
                    <HBox spacing="14">
                        <VBox spacing="7"
                              style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 16;"
                              HBox.hgrow="ALWAYS">
                            <Label style="-fx-text-fill: #68766e; -fx-font-size: 11px; -fx-font-weight: bold;"
                                   text="TOTAL ITEMS"/>
                            <Label fx:id="totalItemsLabel"
                                   style="-fx-text-fill: #174d35; -fx-font-size: 25px; -fx-font-weight: bold;"
                                   text="0"/>
                        </VBox>

                        <VBox spacing="7"
                              style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 16;"
                              HBox.hgrow="ALWAYS">
                            <Label style="-fx-text-fill: #68766e; -fx-font-size: 11px; -fx-font-weight: bold;"
                                   text="LOST ITEMS"/>
                            <Label fx:id="lostItemsLabel"
                                   style="-fx-text-fill: #b45b42; -fx-font-size: 25px; -fx-font-weight: bold;"
                                   text="0"/>
                        </VBox>

                        <VBox spacing="7"
                              style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 16;"
                              HBox.hgrow="ALWAYS">
                            <Label style="-fx-text-fill: #68766e; -fx-font-size: 11px; -fx-font-weight: bold;"
                                   text="FOUND ITEMS"/>
                            <Label fx:id="foundItemsLabel"
                                   style="-fx-text-fill: #28764e; -fx-font-size: 25px; -fx-font-weight: bold;"
                                   text="0"/>
                        </VBox>
                    </HBox>

                    <!-- REPORT FORM -->
                    <VBox spacing="14"
                          style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 18;">

                        <Label style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #174d35;"
                               text="Report an Item"/>

                        <GridPane hgap="14" vgap="11">
                            <columnConstraints>
                                <ColumnConstraints minWidth="115" prefWidth="130"/>
                                <ColumnConstraints hgrow="ALWAYS"/>
                                <ColumnConstraints minWidth="115" prefWidth="130"/>
                                <ColumnConstraints hgrow="ALWAYS"/>
                            </columnConstraints>

                            <rowConstraints>
                                <RowConstraints minHeight="35"/>
                                <RowConstraints minHeight="35"/>
                                <RowConstraints minHeight="35"/>
                                <RowConstraints minHeight="35"/>
                                <RowConstraints minHeight="35"/>
                            </rowConstraints>

                            <Label text="Item Name:"
                                   GridPane.columnIndex="0"
                                   GridPane.rowIndex="0"/>
                            <TextField fx:id="itemNameField"
                                       promptText="Enter item name"
                                       GridPane.columnIndex="1"
                                       GridPane.rowIndex="0"/>

                            <Label text="Category:"
                                   GridPane.columnIndex="2"
                                   GridPane.rowIndex="0"/>
                            <TextField fx:id="categoryField"
                                       promptText="e.g. Electronics"
                                       GridPane.columnIndex="3"
                                       GridPane.rowIndex="0"/>

                            <Label text="Description:"
                                   GridPane.columnIndex="0"
                                   GridPane.rowIndex="1"/>
                            <TextField fx:id="descriptionField"
                                       promptText="Describe the item"
                                       GridPane.columnIndex="1"
                                       GridPane.rowIndex="1"/>

                            <Label text="Location:"
                                   GridPane.columnIndex="2"
                                   GridPane.rowIndex="1"/>
                            <TextField fx:id="locationField"
                                       promptText="Where was it lost/found?"
                                       GridPane.columnIndex="3"
                                       GridPane.rowIndex="1"/>

                            <Label text="Select Campus:"
                                   GridPane.columnIndex="0"
                                   GridPane.rowIndex="2"/>
                            <ComboBox fx:id="campusComboBox"
                                      maxWidth="Infinity"
                                      promptText="Choose campus"
                                      GridPane.columnIndex="1"
                                      GridPane.rowIndex="2"/>

                            <Label text="Date Reported:"
                                   GridPane.columnIndex="2"
                                   GridPane.rowIndex="2"/>
                            <DatePicker fx:id="dateReportedPicker"
                                        maxWidth="Infinity"
                                        promptText="Select date"
                                        GridPane.columnIndex="3"
                                        GridPane.rowIndex="2"/>

                            <Label text="Report Type:"
                                   GridPane.columnIndex="0"
                                   GridPane.rowIndex="3"/>
                            <ComboBox fx:id="typeComboBox"
                                      maxWidth="Infinity"
                                      promptText="Lost or Found"
                                      GridPane.columnIndex="1"
                                      GridPane.rowIndex="3"/>

                            <Label text="Status:"
                                   GridPane.columnIndex="2"
                                   GridPane.rowIndex="3"/>
                            <ComboBox fx:id="statusComboBox"
                                      maxWidth="Infinity"
                                      promptText="Select status"
                                      GridPane.columnIndex="3"
                                      GridPane.rowIndex="3"/>

                            <Label text="Item Picture:"
                                   GridPane.columnIndex="0"
                                   GridPane.rowIndex="4"/>

                            <HBox alignment="CENTER_LEFT"
                                  spacing="10"
                                  GridPane.columnIndex="1"
                                  GridPane.columnSpan="3"
                                  GridPane.rowIndex="4">
                                <Button onAction="#handleChooseImage"
                                        style="-fx-background-color: #e6f1ea; -fx-text-fill: #174d35; -fx-font-weight: bold;"
                                        text="Choose Image"/>
                                <Label fx:id="imageNameLabel"
                                       style="-fx-text-fill: #68766e;"
                                       text="No image selected"/>
                            </HBox>
                        </GridPane>

                        <HBox alignment="CENTER_LEFT" spacing="14">
                            <ImageView fx:id="imagePreview"
                                       fitHeight="85"
                                       fitWidth="115"
                                       preserveRatio="true"/>

                            <HBox spacing="8">
                                <Button onAction="#handleAdd"
                                        style="-fx-background-color: #176b43; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 9 18;"
                                        text="Add Item"/>

                                <Button onAction="#handleUpdate"
                                        style="-fx-background-color: #e5a83b; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 9 18;"
                                        text="Update"/>

                                <Button onAction="#handleDelete"
                                        style="-fx-background-color: #b94a48; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 9 18;"
                                        text="Delete"/>

                                <Button onAction="#handleClear"
                                        style="-fx-background-color: #e8ece9; -fx-text-fill: #263b30; -fx-padding: 9 18;"
                                        text="Clear"/>
                            </HBox>
                        </HBox>
                    </VBox>

                    <!-- REPORTED ITEMS TABLE -->
                    <VBox spacing="12"
                          style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 18;">

                        <HBox alignment="CENTER_LEFT" spacing="10">
                            <Label style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #174d35;"
                                   text="Reported Items"
                                   HBox.hgrow="ALWAYS"/>

                            <TextField fx:id="searchField"
                                       prefWidth="190"
                                       promptText="Search items..."/>

                            <ComboBox fx:id="filterComboBox"
                                      prefWidth="120"
                                      promptText="Filter type"/>

                            <Button onAction="#handleRefresh"
                                    style="-fx-background-color: #176b43; -fx-text-fill: white;"
                                    text="Refresh"/>
                        </HBox>

                        <TableView fx:id="itemsTable"
                                   minHeight="240"
                                   prefHeight="280"
                                   style="-fx-background-color: white;">
                            <columns>
                                <TableColumn fx:id="idColumn"
                                             prefWidth="55"
                                             text="ID"/>

                                <TableColumn fx:id="itemNameColumn"
                                             prefWidth="130"
                                             text="Item Name"/>

                                <TableColumn fx:id="descriptionColumn"
                                             minWidth="130"
                                             prefWidth="190"
                                             text="Description"/>

                                <TableColumn fx:id="categoryColumn"
                                             prefWidth="100"
                                             text="Category"/>

                                <TableColumn fx:id="locationColumn"
                                             minWidth="140"
                                             prefWidth="180"
                                             text="Location"/>

                                <TableColumn fx:id="campusColumn"
                                             minWidth="120"
                                             prefWidth="150"
                                             text="Campus"/>

                                <TableColumn fx:id="dateColumn"
                                             prefWidth="95"
                                             text="Date"/>

                                <TableColumn fx:id="typeColumn"
                                             prefWidth="75"
                                             text="Type"/>

                                <TableColumn fx:id="statusColumn"
                                             prefWidth="85"
                                             text="Status"/>
                            </columns>
                        </TableView>
                    </VBox>

                    <!-- STUDENT POSTS AND COMMENTS -->
                    <VBox spacing="12"
                          style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 18;">

                        <Label style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #174d35;"
                               text="Student Lost &amp; Found Posts"/>

                        <HBox alignment="TOP_LEFT" spacing="16">
                            <VBox spacing="8"
                                  minWidth="300"
                                  HBox.hgrow="ALWAYS">
                                <Label style="-fx-font-weight: bold; -fx-text-fill: #405449;"
                                       text="Recent Posts"/>

                                <VBox fx:id="postFeedBox"
                                      minHeight="120"
                                      spacing="12"
                                      fillWidth="true"
                                      style="-fx-padding: 5;"/>
                            </VBox>

                            <Separator orientation="VERTICAL"
                                       prefHeight="250"/>

                            <VBox minWidth="260"
                                  prefWidth="310"
                                  spacing="9">
                                <Label style="-fx-font-weight: bold; -fx-text-fill: #405449;"
                                       text="Comments"/>

                                <Label fx:id="selectedPostLabel"
                                       style="-fx-text-fill: #263b30;"
                                       text="Select a post to view its comments."
                                       wrapText="true"/>

                                <ScrollPane fitToWidth="true"
                                            prefHeight="170"
                                            VBox.vgrow="ALWAYS">
                                    <content>
                                        <VBox fx:id="commentsBox"
                                              spacing="8"
                                              style="-fx-padding: 6;"/>
                                    </content>
                                </ScrollPane>

                                <HBox spacing="7">
                                    <TextField fx:id="commentField"
                                               onAction="#handleAddComment"
                                               promptText="Write a comment..."
                                               style="-fx-text-fill: black; -fx-prompt-text-fill: #777777; -fx-control-inner-background: white;"
                                               HBox.hgrow="ALWAYS"/>

                                    <Button onAction="#handleAddComment"
                                            style="-fx-background-color: #176b43; -fx-text-fill: white; -fx-font-weight: bold;"
                                            text="Send"/>
                                </HBox>
                            </VBox>
                        </HBox>
                    </VBox>

                </VBox>
            </content>
        </ScrollPane>
    </center>
</BorderPane>