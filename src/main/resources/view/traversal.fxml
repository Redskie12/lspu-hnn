<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.web.WebView?>

<BorderPane xmlns="http://javafx.com/javafx/26"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="system.com.lostfound.TraversalController"
            style="-fx-background-color: #F4F7FB;">

    <center>
        <ScrollPane fitToWidth="true"
                    fitToHeight="false"
                    hbarPolicy="NEVER"
                    vbarPolicy="AS_NEEDED"
                    style="-fx-background-color: #F4F7FB;
                           -fx-background: #F4F7FB;
                           -fx-border-color: transparent;">

            <content>
                <VBox spacing="18"
                      fillWidth="true"
                      maxWidth="Infinity"
                      style="-fx-background-color: #F4F7FB;">

                    <padding>
                        <Insets top="24" bottom="28" left="24" right="24"/>
                    </padding>

                    <!-- PAGE HEADER -->
                    <VBox spacing="6">
                        <Label text="Interactive Campus Traversal"
                               style="-fx-font-size: 27px;
                                      -fx-font-weight: bold;
                                      -fx-text-fill: #075E58;"
                               wrapText="true"/>

                        <Label text="Explore the four LSPU campuses using Breadth-First Search and Depth-First Search."
                               style="-fx-font-size: 13px;
                                      -fx-text-fill: #71857C;"
                               wrapText="true"
                               maxWidth="Infinity"/>
                    </VBox>

                    <!-- MAP AND RIGHT SIDE PANELS -->
                    <GridPane hgap="18"
                              vgap="18"
                              maxWidth="Infinity">

                        <columnConstraints>
                            <ColumnConstraints percentWidth="62"
                                               hgrow="ALWAYS"
                                               minWidth="0"/>

                            <ColumnConstraints percentWidth="38"
                                               hgrow="ALWAYS"
                                               minWidth="0"/>
                        </columnConstraints>

                        <!-- LEFT: INTERACTIVE MAP CARD -->
                        <VBox spacing="14"
                              alignment="CENTER"
                              minWidth="0"
                              maxWidth="Infinity"
                              GridPane.columnIndex="0"
                              GridPane.rowIndex="0"
                              GridPane.rowSpan="2"
                              style="-fx-background-color: white;
                                     -fx-background-radius: 12;
                                     -fx-border-color: #DCEAE8;
                                     -fx-border-radius: 12;
                                     -fx-border-width: 1;">

                            <padding>
                                <Insets top="20" bottom="20" left="18" right="18"/>
                            </padding>

                            <Label text="INTERACTIVE CAMPUS NETWORK MAP"
                                   style="-fx-font-size: 17px;
                                          -fx-font-weight: bold;
                                          -fx-text-fill: #075E58;"
                                   wrapText="true"/>

                            <!-- MAP VIEW -->
                            <StackPane prefHeight="470"
                                       minHeight="350"
                                       maxWidth="Infinity"
                                       style="-fx-background-color: #F4F7FB;
                                              -fx-background-radius: 10;
                                              -fx-border-color: #DCEAE8;
                                              -fx-border-radius: 10;
                                              -fx-border-width: 1;">

                                <WebView fx:id="mapView"
                                         minWidth="0"
                                         minHeight="350"
                                         prefHeight="470"
                                         maxWidth="Infinity"
                                         maxHeight="Infinity"/>
                            </StackPane>

                            <Label fx:id="mapStatusLabel"
                                   text="Loading interactive campus map..."
                                   style="-fx-font-size: 12px;
                                          -fx-text-fill: #71857C;"
                                   wrapText="true"
                                   maxWidth="Infinity"/>

                            <!-- MAP LEGEND -->
                            <HBox spacing="18"
                                  alignment="CENTER"
                                  maxWidth="Infinity">

                                <HBox spacing="6" alignment="CENTER">
                                    <Label text="●"
                                           style="-fx-font-size: 17px;
                                                  -fx-text-fill: #94A3B8;"/>
                                    <Label text="Unvisited"
                                           style="-fx-font-size: 11px;
                                                  -fx-text-fill: #475569;"/>
                                </HBox>

                                <HBox spacing="6" alignment="CENTER">
                                    <Label text="●"
                                           style="-fx-font-size: 17px;
                                                  -fx-text-fill: #F59E0B;"/>
                                    <Label text="Current"
                                           style="-fx-font-size: 11px;
                                                  -fx-text-fill: #475569;"/>
                                </HBox>

                                <HBox spacing="6" alignment="CENTER">
                                    <Label text="●"
                                           style="-fx-font-size: 17px;
                                                  -fx-text-fill: #01796F;"/>
                                    <Label text="Visited"
                                           style="-fx-font-size: 11px;
                                                  -fx-text-fill: #475569;"/>
                                </HBox>

                            </HBox>

                            <Label text="Click a campus marker to view its information."
                                   style="-fx-font-size: 11px;
                                          -fx-text-fill: #71857C;"
                                   wrapText="true"
                                   maxWidth="Infinity"/>

                            <!-- TRAVERSAL CONTROLS -->
                            <VBox spacing="12"
                                  maxWidth="Infinity">

                                <Label text="TRAVERSAL CONTROLS"
                                       style="-fx-font-size: 16px;
                                              -fx-font-weight: bold;
                                              -fx-text-fill: #075E58;"/>

                                <HBox spacing="10"
                                      alignment="CENTER"
                                      maxWidth="Infinity">

                                    <Button text="Run BFS"
                                            onAction="#handleBFS"
                                            prefWidth="120"
                                            prefHeight="40"
                                            style="-fx-background-color: #01796F;
                                                   -fx-text-fill: white;
                                                   -fx-font-size: 12px;
                                                   -fx-font-weight: bold;
                                                   -fx-background-radius: 8;
                                                   -fx-cursor: hand;"/>

                                    <Button text="Run DFS"
                                            onAction="#handleDFS"
                                            prefWidth="120"
                                            prefHeight="40"
                                            style="-fx-background-color: #075E58;
                                                   -fx-text-fill: white;
                                                   -fx-font-size: 12px;
                                                   -fx-font-weight: bold;
                                                   -fx-background-radius: 8;
                                                   -fx-cursor: hand;"/>

                                    <Button text="Reset"
                                            onAction="#handleReset"
                                            prefWidth="100"
                                            prefHeight="40"
                                            style="-fx-background-color: #DCEAE8;
                                                   -fx-text-fill: #075E58;
                                                   -fx-font-size: 12px;
                                                   -fx-font-weight: bold;
                                                   -fx-background-radius: 8;
                                                   -fx-cursor: hand;"/>

                                </HBox>
                            </VBox>

                        </VBox>

                        <!-- RIGHT: CURRENT CAMPUS PANEL -->
                        <VBox spacing="14"
                              minWidth="0"
                              maxWidth="Infinity"
                              GridPane.columnIndex="1"
                              GridPane.rowIndex="0"
                              style="-fx-background-color: white;
                                     -fx-background-radius: 12;
                                     -fx-border-color: #DCEAE8;
                                     -fx-border-radius: 12;
                                     -fx-border-width: 1;">

                            <padding>
                                <Insets top="20" bottom="20" left="18" right="18"/>
                            </padding>

                            <Label text="CURRENT CAMPUS PANEL"
                                   style="-fx-font-size: 17px;
                                          -fx-font-weight: bold;
                                          -fx-text-fill: #075E58;"
                                   wrapText="true"/>

                            <VBox spacing="5">
                                <Label text="CURRENT NODE"
                                       style="-fx-font-size: 11px;
                                              -fx-font-weight: bold;
                                              -fx-text-fill: #71857C;"/>

                                <Label fx:id="currentCampusLabel"
                                       text="Siniloan"
                                       style="-fx-font-size: 19px;
                                              -fx-font-weight: bold;
                                              -fx-text-fill: #01796F;"
                                       wrapText="true"
                                       maxWidth="Infinity"/>
                            </VBox>

                            <!-- CAMPUS IMAGE -->
                            <StackPane fx:id="campusImageContainer"
                                       prefHeight="155"
                                       minHeight="130"
                                       maxHeight="180"
                                       maxWidth="Infinity"
                                       style="-fx-background-color: #F4F7FB;
                                              -fx-background-radius: 10;
                                              -fx-border-color: #DCEAE8;
                                              -fx-border-radius: 10;">

                                <ImageView fx:id="campusImage"
                                           fitWidth="280"
                                           fitHeight="155"
                                           preserveRatio="true"
                                           smooth="true"/>
                            </StackPane>

                            <!-- LOCATION -->
                            <VBox spacing="5">
                                <Label text="LOCATION"
                                       style="-fx-font-size: 11px;
                                              -fx-font-weight: bold;
                                              -fx-text-fill: #71857C;"/>

                                <Label fx:id="campusLocationLabel"
                                       text="Siniloan, Laguna"
                                       style="-fx-font-size: 13px;
                                              -fx-text-fill: #334155;"
                                       wrapText="true"
                                       maxWidth="Infinity"/>
                            </VBox>

                            <!-- CAMPUS INFORMATION -->
                            <VBox spacing="5">
                                <Label text="CAMPUS INFORMATION"
                                       style="-fx-font-size: 11px;
                                              -fx-font-weight: bold;
                                              -fx-text-fill: #71857C;"
                                       wrapText="true"/>

                                <Label fx:id="campusDescriptionLabel"
                                       text="Campus description will appear here."
                                       style="-fx-font-size: 12px;
                                              -fx-text-fill: #475569;"
                                       wrapText="true"
                                       maxWidth="Infinity"/>
                            </VBox>

                            <!-- PROGRAMS OFFERED -->
                            <VBox spacing="5">
                                <Label text="PROGRAMS OFFERED"
                                       style="-fx-font-size: 11px;
                                              -fx-font-weight: bold;
                                              -fx-text-fill: #71857C;"/>

                                <Label fx:id="campusProgramsLabel"
                                       text="Campus programs will appear here."
                                       style="-fx-font-size: 12px;
                                              -fx-text-fill: #475569;"
                                       wrapText="true"
                                       maxWidth="Infinity"/>
                            </VBox>

                            <!-- DISTANCE INFORMATION -->
                            <VBox spacing="10"
                                  style="-fx-background-color: #F4F7FB;
                                         -fx-background-radius: 10;
                                         -fx-border-color: #DCEAE8;
                                         -fx-border-radius: 10;">

                                <padding>
                                    <Insets top="14" bottom="14" left="12" right="12"/>
                                </padding>

                                <Label text="DISTANCE INFORMATION"
                                       style="-fx-font-size: 13px;
                                              -fx-font-weight: bold;
                                              -fx-text-fill: #075E58;"
                                       wrapText="true"/>

                                <VBox spacing="4">
                                    <Label text="Previous Campus Distance"
                                           style="-fx-font-size: 11px;
                                                  -fx-text-fill: #71857C;"
                                           wrapText="true"/>

                                    <Label fx:id="distanceLabel"
                                           text="Distance from previous campus: 0 km"
                                           style="-fx-font-size: 12px;
                                                  -fx-font-weight: bold;
                                                  -fx-text-fill: #334155;"
                                           wrapText="true"
                                           maxWidth="Infinity"/>
                                </VBox>

                                <VBox spacing="4">
                                    <Label text="Total Travel Distance"
                                           style="-fx-font-size: 11px;
                                                  -fx-text-fill: #71857C;"
                                           wrapText="true"/>

                                    <Label fx:id="totalDistanceLabel"
                                           text="Total distance: 0 km"
                                           style="-fx-font-size: 14px;
                                                  -fx-font-weight: bold;
                                                  -fx-text-fill: #01796F;"
                                           wrapText="true"
                                           maxWidth="Infinity"/>
                                </VBox>

                            </VBox>

                        </VBox>

                        <!-- RIGHT: TRAVERSAL STATUS BELOW CAMPUS PANEL -->
                        <VBox spacing="13"
                              maxWidth="Infinity"
                              minWidth="0"
                              GridPane.columnIndex="1"
                              GridPane.rowIndex="1"
                              style="-fx-background-color: white;
                                     -fx-background-radius: 12;
                                     -fx-border-color: #DCEAE8;
                                     -fx-border-radius: 12;
                                     -fx-border-width: 1;">

                            <padding>
                                <Insets top="18" bottom="18" left="20" right="20"/>
                            </padding>

                            <Label text="TRAVERSAL STATUS"
                                   style="-fx-font-size: 17px;
                                          -fx-font-weight: bold;
                                          -fx-text-fill: #075E58;"/>

                            <VBox spacing="5">
                                <Label text="CURRENT STATUS"
                                       style="-fx-font-size: 11px;
                                              -fx-font-weight: bold;
                                              -fx-text-fill: #71857C;"/>

                                <Label fx:id="statusLabel"
                                       text="Ready to start traversal."
                                       style="-fx-font-size: 13px;
                                              -fx-text-fill: #334155;"
                                       wrapText="true"
                                       maxWidth="Infinity"/>
                            </VBox>

                            <VBox spacing="5">
                                <Label text="VISIT ORDER"
                                       style="-fx-font-size: 11px;
                                              -fx-font-weight: bold;
                                              -fx-text-fill: #71857C;"/>

                                <Label fx:id="resultLabel"
                                       text="Traversal order will appear here."
                                       style="-fx-font-size: 13px;
                                              -fx-text-fill: #334155;"
                                       wrapText="true"
                                       maxWidth="Infinity"/>
                            </VBox>

                        </VBox>

                    </GridPane>

                </VBox>
            </content>
        </ScrollPane>
    </center>

</BorderPane>
